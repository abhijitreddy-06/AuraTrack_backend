DB_NAME=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
# Set true only when your PostgreSQL server requires SSL. Keep false for a local database.
DB_SSL=false
# Optional: a PostgreSQL URL. This takes precedence over the DB_* values above.
# DATABASE_URL=postgresql://username:password@host:5432/database_name
# Optional: your Supabase PostgreSQL connection string. This takes precedence over DATABASE_URL and DB_*.
# On Render, use Supabase's Session Pooler URL (host ends in .pooler.supabase.com, port 5432),
# not the direct db.<project-ref>.supabase.co URL, which is IPv6-only by default.
# SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-your-region.pooler.supabase.com:5432/postgres
ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
PASSWORD_VAULT_KEY=replace_with_a_unique_64_character_hex_key
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://auratrack-9z5t.onrender.com
OPENROUTER_APP_NAME=AuraTrack
PORT=5000
